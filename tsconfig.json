{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Ambient type packages, declared explicitly. TypeScript 7 no longer picks
       every node_modules/@types entry up implicitly under bundler resolution, so
       `process` (node) and the test globals stopped resolving. Naming them is
       also the reproducible form: the set no longer depends on what happens to be
       installed. */
    "types": ["node", "jest", "@testing-library/jest-dom"]
  },
  "include": ["src"],
  "exclude": [
    "src/components/Scene/__fixtures__/scene-legacy-public-props.fixture.tsx",
    "src/components/Animate/__fixtures__/animate-video-illegal-props.fixture.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
