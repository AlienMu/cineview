{
  "name": "cineview",
  "version": "1.0.0",
  "description": "React UI framework for creating cinematic full-screen sliding pages",
  "main": "dist/cineview.umd.js",
  "module": "dist/cineview.es.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/cineview.es.mjs",
      "require": "./dist/cineview.umd.js"
    },
    "./drag": {
      "types": "./dist/entry-drag.d.ts",
      "require": "./dist/cineview-drag.umd.js"
    },
    "./scroll": {
      "types": "./dist/entry-scroll.d.ts",
      "require": "./dist/cineview-scroll.umd.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/cineview-dev.es.mjs"
    },
    "./dev/style.css": "./dist/cineview-dev.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.css",
    "dist/artifacts.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-all.mjs && node scripts/minify-library-entries.mjs",
    "build:verify": "pnpm run build && node scripts/verify-build.js",
    "preview": "vite preview",
    "test": "jest",
    "test:examples": "pnpm --dir examples/performance-test test",
    "test:site-contracts": "jest --runInBand src/__tests__/site",
    "test:browser": "pnpm build && pnpm --dir examples/performance-test acceptance:browser",
    "quality:duplicates": "jscpd --config .jscpd.json src",
    "verify:failure-injection": "node scripts/verify-failure-injection.js",
    "verify:browser-failure-injection": "pnpm --dir examples/performance-test acceptance:failure-injection",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:framework": "jest --config jest.framework.config.js --coverage --runInBand",
    "test:coverage:watch": "jest --coverage --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "pnpm format:framework && pnpm format:site",
    "format:framework": "prettier --write \"src/**/*.{ts,tsx}\" \"examples/performance-test/**/*.{ts,tsx,js,mjs,json}\" \".github/**/*.{yml,yaml}\" \"*.{ts,js,json,md}\" \"scripts/*.{js,mjs}\"",
    "format:site": "prettier --write \"site/src/**/*.{ts,tsx,css}\" \"site/*.{ts,json,html}\"",
    "format:check": "pnpm format:check:framework && pnpm format:check:site",
    "format:check:framework": "prettier --check \"src/**/*.{ts,tsx}\" \"examples/performance-test/**/*.{ts,tsx,js,mjs,json}\" \".github/**/*.{yml,yaml}\" \"*.{ts,js,json,md}\" \"scripts/*.{js,mjs}\"",
    "format:check:site": "prettier --check \"site/src/**/*.{ts,tsx,css}\" \"site/*.{ts,json,html}\"",
    "type-check": "tsc --noEmit",
    "type-check:framework": "tsc -p tsconfig.framework.json --noEmit",
    "type-check:site": "pnpm --dir site type-check",
    "type-check:examples": "pnpm --dir examples/minimal type-check && pnpm --dir examples/performance-test type-check",
    "prepublishOnly": "pnpm verify:framework:static",
    "prepare": "husky",
    "analyze": "vite build && open stats.html",
    "lighthouse": "lighthouse http://localhost:3000 --view",
    "verify:framework:static": "pnpm format:check:framework && pnpm type-check:framework && pnpm type-check:examples && pnpm lint && pnpm test:coverage:framework && pnpm test:examples && pnpm quality:duplicates && pnpm build:verify && pnpm verify:failure-injection",
    "verify:framework": "pnpm verify:framework:static && pnpm test:browser && pnpm verify:browser-failure-injection",
    "docs:style:static": "pnpm --dir site exec node tools/docs-style-probe.mjs --static",
    "docs:style": "pnpm --dir site exec node tools/docs-style-probe.mjs",
    "a11y:probe": "pnpm --dir site exec node tools/a11y-probe.mjs",
    "verify:all": "pnpm verify:framework && pnpm format:check:site && pnpm type-check && pnpm type-check:site && pnpm test:site-contracts && pnpm docs:style:static",
    "verify": "pnpm verify:all"
  },
  "peerDependencies": {
    "framer-motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fast-check/jest": "^2.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.6.0",
    "framer-motion": "^13.2.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jscpd": "5.1.1",
    "lint-staged": "^17.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rollup-plugin-visualizer": "^7.1.1",
    "terser": "5.46.1",
    "ts-jest": "^29.4.12",
    "ts-prune": "^0.10.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.0",
    "vite-plugin-dts": "^5.1.0"
  },
  "keywords": [
    "react",
    "ui",
    "framework",
    "animation",
    "fullscreen",
    "slider",
    "cinematic"
  ],
  "author": "Alien.mu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlienMu/cineview.git"
  },
  "homepage": "https://cineview.pages.dev",
  "bugs": {
    "url": "https://github.com/AlienMu/cineview/issues"
  },
  "packageManager": "pnpm@10.22.0",
  "browserslist": [
    "chrome >= 85",
    "edge >= 85",
    "firefox >= 79",
    "safari >= 14",
    "ios_saf >= 14",
    "not dead"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=3.1.3"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.1 || >=24.0.0",
      "onFail": "error"
    }
  }
}
