{
  "name": "cineview",
  "version": "0.0.1-beta",
  "description": "React UI framework for creating cinematic full-screen sliding pages",
  "main": "dist/cineview.umd.js",
  "module": "dist/cineview.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:verify": "pnpm run build && node scripts/verify-build.js",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:watch": "jest --coverage --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "pnpm run type-check && pnpm run lint && pnpm run test:coverage && pnpm run build:verify",
    "prepare": "husky install",
    "analyze": "vite build && open stats.html",
    "lighthouse": "lighthouse http://localhost:3000 --view"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "framer-motion": "^11.0.0"
  },
  "devDependencies": {
    "@fast-check/jest": "^1.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "fast-check": "^4.6.0",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rollup-plugin-visualizer": "^5.0.0",
    "ts-jest": "^29.0.0",
    "ts-prune": "^0.10.3",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-compression": "^0.5.0",
    "vite-plugin-dts": "^3.0.0"
  },
  "keywords": [
    "react",
    "ui",
    "framework",
    "animation",
    "fullscreen",
    "slider",
    "cinematic"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "packageManager": "pnpm@10.22.0"
}
