{
  "name": "cineview",
  "version": "2.0.1",
  "description": "A landing-page framework in plain HTML: scenes with their own timelines, moved by the reader’s scroll or finger",
  "type": "module",
  "main": "./dist/cineview.js",
  "module": "./dist/cineview.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/cineview.js"
    },
    "./jsx": {
      "types": "./dist/types/jsx.d.ts"
    },
    "./dev": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/dev/cineview.js"
    },
    "./cineview.css": "./dist/cineview.css",
    "./head.js": "./dist/head.js",
    "./surface.json": "./dist/surface.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/cineview.js",
    "./dist/dev/cineview.js",
    "./dist/chunks/*.js",
    "./dist/dev/chunks/*.js",
    "**/*.css"
  ],
  "files": [
    "dist/cineview.js",
    "dist/cineview.css",
    "dist/head.js",
    "dist/surface.json",
    "dist/chunks",
    "dist/dev",
    "dist/types"
  ],
  "keywords": [
    "landing-page",
    "scroll",
    "animation",
    "custom-elements",
    "web-components",
    "timeline",
    "drag"
  ],
  "author": "Alien.mu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlienMu/cineview.git"
  },
  "homepage": "https://cineview.pages.dev",
  "bugs": {
    "url": "https://github.com/AlienMu/cineview/issues"
  },
  "packageManager": "pnpm@10.22.0",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "type-check": "tsc -p tsconfig.json",
    "test": "jest --config jest.config.cjs --runInBand",
    "test:coverage": "jest --config jest.config.cjs --runInBand --coverage --coverageReporters=json-summary --coverageReporters=text-summary --collectCoverageFrom='src/**/*.ts' --collectCoverageFrom='!src/**/*.test.ts' --collectCoverageFrom='!src/env.d.ts' && node scripts/write-coverage-badge.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\" \"*.{js,cjs,mjs,json,md}\" \"scripts/*.mjs\" \"device-test/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test:browser": "node gate/checks.mjs chromium webkit",
    "perf": "node gate/run-phase1.mjs chrome webkit",
    "device": "node build.mjs && node device-test/serve.mjs",
    "verify:repository": "node scripts/verify-repository.mjs",
    "verify": "pnpm verify:repository && pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build && pnpm verify:site",
    "verify:site": "pnpm --dir site type-check && jest --config site/jest.contracts.config.js --runInBand && pnpm docs:style:static && pnpm --dir site build",
    "docs:style:static": "pnpm --dir site exec node tools/docs-style-probe.mjs --static",
    "docs:style": "pnpm --dir site exec node tools/docs-style-probe.mjs",
    "docs:links": "node scripts/verify-documentation.mjs",
    "audit:all": "node scripts/audit-all.mjs",
    "prepublishOnly": "pnpm verify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.6.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "lint-staged": "^17.4.1",
    "playwright": "^1.63.0",
    "prettier": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "pnpm": {
    "overrides": {
      "minimatch": ">=3.1.3"
    }
  }
}
