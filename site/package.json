{
  "name": "cineview-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:framework": "pnpm --dir .. run build",
    "build:cf": "pnpm run build:framework && pnpm run build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "format": "pnpm --dir .. exec prettier --write \"site/src/**/*.{ts,tsx,css}\" \"site/*.{ts,json,html}\"",
    "format:check": "pnpm --dir .. exec prettier --check \"site/src/**/*.{ts,tsx,css}\" \"site/*.{ts,json,html}\""
  },
  "dependencies": {
    "cineview": "link:../",
    "framer-motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.0",
    "rehype-highlight": "^7.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "playwright": "^1.61.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
