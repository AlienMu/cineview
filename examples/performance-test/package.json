{
  "name": "cineview-performance-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:acceptance": "vite build --config vite.acceptance.config.ts",
    "profile:browser": "node profile-production.mjs",
    "acceptance:drag": "node acceptance-drag.mjs",
    "acceptance:scroll": "node acceptance-scroll.mjs",
    "acceptance:browser": "pnpm acceptance:drag && pnpm acceptance:scroll",
    "acceptance:failure-injection": "node verify-browser-failure-injection.mjs",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "format": "pnpm --dir ../.. exec prettier --write \"examples/performance-test/**/*.{ts,tsx,js,mjs,json}\"",
    "format:check": "pnpm --dir ../.. exec prettier --check \"examples/performance-test/**/*.{ts,tsx,js,mjs,json}\"",
    "preview": "vite preview",
    "lighthouse": "pnpm run build && pnpm run preview & sleep 3 && lighthouse http://localhost:4173 --view --output html --output-path ./lighthouse-report.html"
  },
  "dependencies": {
    "cineview": "link:../..",
    "framer-motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.1 || >=24.0.0"
  }
}
